# calling_api_v2 — имена переменных (значения не коммитить). Файл .env читает lib/env.js (dotenv).
PORT=4444
APN_VOIP_TOPIC=app.totus.club.voip

# =
#  База (та же MySQL kedam, что у totus_API). Обязательно.
# =
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=kedam

# =
#  Auth (SECURITY_JWT_PLAN_RU.md). ТЕ ЖЕ значения, что в /home/kedam_API/.env (totus_API) —
#  один эмитент токенов на все сервисы. Обязательно.
# =
JWT_SECRET=
JWT_REFRESH_SECRET=
# log — запросы/сокеты без токена пропускаются с логом [AUTH]; enforce — 401/403 (только после релиза приложения!)
AUTH_MODE=log
# CSV префиксов путей, остающихся в log при enforce, напр.: /api/tour-assistant,/api/tts
AUTH_LOG_ONLY_PATHS=
AGENT_ACCESS_TTL=12h
AGENT_REFRESH_TTL=30d
# CSV разрешённых origin'ов (пусто = домены totus.club + localhost, см. lib/security.js)
CORS_ORIGINS=
AUTH_RATE_WINDOW_MS=900000
AUTH_RATE_LIMIT=30

# =
#  Support Chat (lib/supportChat.js, таблицы — scripts/run-support-chat-migration.js). Необязательно.
# =
# Сообщений в минуту от одного пользователя (по умолчанию 30)
SUPPORT_CHAT_RATE_LIMIT=30
# Текст о часах работы в пустом состоянии чата (по умолчанию: ежедневно 9:00–21:00 МСК, ответ ~5 минут)
SUPPORT_HOURS_TEXT=

# =
#  Push-уведомления — хаб lib/notifications (таблицы — scripts/run-notifications-migration.js,
#  API — docs/NOTIFICATIONS_API.md). iOS и Android идут через FCM (FIREBASE_CREDENTIALS_PATH ниже;
#  для iOS в консоль Firebase нужно загрузить APNs-ключ .p8). Сайт — Web Push (VAPID).
# =
# Секрет внутреннего API: totus_API → POST /internal/notify (заголовок X-Internal-Key). То же значение в .env totus_API.
# Сгенерировать: openssl rand -hex 32. Без ключа /internal/* отвечает 503.
INTERNAL_API_KEY=
# VAPID-ключи Web Push: node scripts/generate-vapid-keys.js (публичный ключ также нужен сайту, он не секрет)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@totus.club
# Тихие часы (МСК) для маркетинга и напоминаний с поведением «перенести»: пуши откладываются до конца интервала
PUSH_QUIET_HOURS=21:00-09:00

# =
#  Ключи ВНЕ репозитория (Б.1). Файлы хранить, например, в /home/secrets/calling/ (chmod 600).
# =
# APNs VoIP-пуши (iOS). Без этих трёх переменных пуши на iOS отключены (лог [apn] disabled).
APN_KEY_PATH=/home/secrets/calling/AuthKey_XXXXXXXXXX.p8
APN_KEY_ID=
APN_TEAM_ID=
# 1 (по умолчанию) — production APNs, 0 — sandbox
APN_PRODUCTION=1
# Firebase Admin SDK (FCM-пуши Android). Без него [fcm] disabled.
FIREBASE_CREDENTIALS_PATH=/home/secrets/calling/firebase-adminsdk.json
# Google Cloud Text-to-Speech (сервисный аккаунт). Без него /api/tts/* отвечает ошибкой конфигурации.
GOOGLE_APPLICATION_CREDENTIALS=/home/secrets/calling/google-tts.json
# DeepSeek (legacy tour-assistant в этом сервисе). Без ключа эндпоинты ИИ отвечают ошибкой.
DEEPSEEK_API_KEY=

# =
#  TURN/STUN — GET /api/ice-servers (Б.1: креды больше не зашиты в клиенты).
#  ВарианА (целевой): coturn в use-auth-secret; TURN_SECRET = static-auth-secret из turnserver.conf
#  (сгенерировать: openssl rand -hex 32). Креды временные, TTL ниже.
#  Вариант Б (переходный): coturn с lt-cred-mech; задать TURN_STATIC_USERNAME/TURN_STATIC_CREDENTIAL
#  (новую пару вместо утёкшей test/…). Если не задано ничего — отдаётся только STUN (relay не работает).
# =
TURN_SECRET=
TURN_TTL_SECONDS=43200
TURN_STATIC_USERNAME=
TURN_STATIC_CREDENTIAL=
# CSV; по умолчанию — stun1/2 и turn1/2.totus.club (см. lib/iceServers.js)
STUN_URLS=
TURN_URLS=
